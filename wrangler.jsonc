{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deskside",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/mcp", "/mcp/*", "/api/*"] },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "deskside", "database_id": "c200c91a-d0a4-4697-9eb8-7a139bba11d3" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
